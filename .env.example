# contino.ai settings. Copy this file to .env and fill it in.
# .env is git-ignored: never commit keys.
# contino.ai keeps all data in PostgreSQL and every file in Cloudflare R2.
# Check your settings and connections with:  cd api && python -m app.check

# =====================================================================
# 1. OPENAI
# =====================================================================
OPENAI_API_KEY=
# Image model: character/place pictures, storyboard sketches, finals
IMAGE_MODEL=gpt-image-2.6-sunburst
# Text model: reads the Shot Planner PDF
TEXT_MODEL=gpt-6.2-sol
# Vision model: the AI check that scores pictures and shots
REVIEW_MODEL=gpt-6.2-sol

# =====================================================================
# 2. SIGN-IN (users sign in with their email; the email is their user id)
# =====================================================================
# Signs the sign-in cookie (required).
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Optional team access code people must enter to sign in. Leave empty for none.
API_TOKEN=

# =====================================================================
# 3. DATABASE + FILE STORAGE (required)
# =====================================================================
# PostgreSQL connection string, e.g. from neon.tech (use the "pooled" one):
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
# Database connections per process (small values suit serverless hosts)
DB_POOL_MIN=4
DB_POOL_MAX=20

# Cloudflare R2 (Cloudflare dashboard > R2 > your bucket; keep the bucket private)
# Account ID: shown on the R2 overview page
R2_ACCOUNT_ID=
# R2 > Manage API tokens > Create token (Object Read & Write on the bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name, e.g. contino-images
R2_BUCKET=

# =====================================================================
# 4. WEB ACCESS
# =====================================================================
# Website address(es) allowed to call the API, comma-separated (no trailing /).
# Local: http://localhost:5173   Online: your frontend URL, e.g. https://contino-ai.vercel.app
CORS_ORIGINS=http://localhost:5173
# Optional pattern for extra addresses, e.g. Vercel preview URLs:
CORS_ORIGIN_REGEX=
# true only when the frontend and API are on different domains (online deploys)
COOKIE_CROSS_SITE=false

# =====================================================================
# 5. RUNNING
# =====================================================================
# true = the image worker runs inside the API (one server)
# false = you run separate workers with: python -m app.worker
EMBEDDED_WORKER=true
LOG_LEVEL=INFO
