# Copy to .env and fill in. .env is git-ignored. Never commit keys.

STORAGE_MODE=local          # local | cloud
OPENAI_API_KEY=

# Models (override config.yaml). Use names your key has access to.
# Image model: references, storyboard panels, finals
IMAGE_MODEL=gpt-image-2.6-sunburst
# Text model: parses the Shot Planner PDF
TEXT_MODEL=
# Vision model: AI review that scores each panel
REVIEW_MODEL=

# Optional: when set, every API call needs this token (header or login cookie).
API_TOKEN=

# Run the job worker inside the API process (true for local dev; false when
# running dedicated `python -m app.worker` processes).
EMBEDDED_WORKER=true

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO

# cloud mode only
DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- deployment (frontend and API on different domains, e.g. two Vercel projects)
# CORS_ORIGINS=https://contino.vercel.app
# CORS_ORIGIN_REGEX=https://contino-.*\.vercel\.app
# COOKIE_CROSS_SITE=true
# DB_POOL_MIN=0
# DB_POOL_MAX=5
