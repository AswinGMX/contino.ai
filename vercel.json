{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["api/app/**", "prompts/**", "config.yaml"], "maxLambdaSize": "60mb" }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "api/index.py" }]
}
